# Where the API lives. Leave as "/api" to use the Vite dev proxy (recommended).
# Set to an absolute URL (e.g. https://api.s2vestis.com/api) for production builds.
VITE_API_BASE_URL=/api

# Optional: override the dev proxy target (defaults to http://localhost:5050)
VITE_API_PROXY=http://localhost:5050
