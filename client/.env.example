# Where the API lives. Leave as "/api" to use the Vite dev proxy (recommended).
# Set to an absolute URL (e.g. https://api.s2vestis.com/api) for production builds.
VITE_API_BASE_URL=/api

# Optional: override the dev proxy target (defaults to http://localhost:5050)
VITE_API_PROXY=http://localhost:5050

# ---- Google sign-in (via Supabase Auth) ----
# Project Settings → API in the Supabase dashboard. The ANON/PUBLIC key only —
# never the service_role key here, this ships to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_the_anon_public_key
