# ---- Core ----
NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

# ---- Database (Supabase) ----
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_the_service_role_key

# ---- Auth ----
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ---- Image uploads (optional) ----
# If these three are set, uploads go to Cloudinary.
# If any is missing, the server falls back to local ./uploads storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seed admin (used by `npm run seed`) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@s2vestis.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=user@s2vestis.com
SEED_USER_PASSWORD=User@12345
